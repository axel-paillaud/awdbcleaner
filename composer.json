{
  "name": "axelweb/awdbcleaner",
  "description": "Truncates PrestaShop statistics tables (CLI command and back office page)",
  "type": "prestashop-module",
  "license": "AFL-3.0",
  "authors": [
    {
      "name": "Axelweb",
      "email": "contact@axelweb.fr"
    }
  ],
  "autoload": {
    "psr-4": {
      "Axelweb\\AwDbCleaner\\": "src/"
    }
  },
  "require": {
    "php": ">=7.2"
  },
  "config": {
    "prepend-autoloader": false,
    "autoloader-suffix": "AwDbCleaner"
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.89"
  }
}
